[Unit]
Description=AIOS Mobile Agent Web UI
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=aios
Group=aios
WorkingDirectory=/opt/aios/apps/aios-mobile-agent
Environment=NODE_ENV=production
Environment=WORKSPACE=/opt/aios
# + prefix: run as root so stale processes from an old root-based install can be stopped.
Environment=PATH=/var/lib/aios/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=+/opt/aios/apps/aios-mobile-agent/systemd/kill-stale-server.sh
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
